<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.subject.mapper.AdminRoleMenuMapper">
    <update id="UpdateRoleMenu" useGeneratedKeys="true" parameterType="java.util.List">
        INSERT INTO admin_role_menu(id,rid,mid) VALUES
        <foreach collection="list" item="item" separator="," index="index">
            (#{item.id},#{item.rid},#{item.mid})
        </foreach>
        on duplicate key update
        rid=values(rid),
        mid=values(mid)
    </update>
</mapper>
