<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.subject.mapper.AdminRolePermissionMapper">
    <update id="UpdateRolePermission" useGeneratedKeys="true" parameterType="java.util.List">
        INSERT INTO admin_role_permission(id,rid,pid) VALUES
        <foreach collection="list" item="item" index="index" open="" close="" separator=",">
                   (#{item.id},#{item.rid},#{item.pid})
        </foreach>
        on duplicate key update
        rid=values(rid),
        pid=values(pid)
    </update>
</mapper>
